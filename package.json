{
  "name": "interface-ai-computer-use-automation",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "npm run clean && tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.test.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "coverage": "vitest run --coverage",
    "clean": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\"",
    "setup": "node scripts/setup.mjs",
    "demo": "npm run build && node --env-file-if-exists=.env --input-type=module -e \"import('./dist/src/demo/cli.js').then(m => m.main(process.argv.slice(1))).catch(() => { console.error('Demo stopped. Check configuration and evidence; no raw error is printed.'); process.exitCode = 1; })\" --",
    "verify:evidence": "npm run build && node scripts/verify-submission-evidence.mjs",
    "gui": "npm run build && node --env-file-if-exists=.env dist/src/gui/launcher.js"
  },
  "dependencies": {
    "zod": "^4.1.5"
  },
  "devDependencies": {
    "@types/node": "26.6.2",
    "@vitest/coverage-v8": "^5.0.1",
    "playwright": "^1.63.0",
    "typescript": "^5.9.2",
    "vitest": "^5.0.1"
  },
  "engines": {
    "node": "26.x"
  },
  "allowScripts": {
    "fsevents@2.3.3": true
  }
}
